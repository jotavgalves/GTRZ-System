{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/**/*.ts"],
      "project": ["**/*.{ts,tsx,mjs}", "!output/**", "!tmp/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/main.tsx",
        "electron.vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["better-sqlite3"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/database": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "project": ["src/**/*.ts"]
    }
  }
}
