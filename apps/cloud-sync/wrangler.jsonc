{
  "name": "gtrz-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "SYNC_AUDIT_ARCHIVE",
      "bucket_name": "gtrz-sync-audit",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_ROOM",
        "class_name": "EventRoomFresh",
      },
      {
        "name": "MONITOR_ROOM",
        "class_name": "MonitorRoomFresh",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MonitorRoom"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["EventRoomFresh", "MonitorRoomFresh"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["EventRoom", "MonitorRoom"],
    },
  ],
  "env": {
    "test": {
      "r2_buckets": [
        {
          "binding": "SYNC_AUDIT_ARCHIVE",
          "bucket_name": "gtrz-sync-test-audit",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "EVENT_ROOM",
            "class_name": "EventRoomFresh",
          },
          {
            "name": "MONITOR_ROOM",
            "class_name": "MonitorRoomFresh",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["EventRoom"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["MonitorRoom"],
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["EventRoomFresh", "MonitorRoomFresh"],
        },
        {
          "tag": "v4",
          "deleted_classes": ["EventRoom", "MonitorRoom"],
        },
      ],
      "vars": {
        "GTRZ_ENVIRONMENT": "test",
      },
    },
  },
}
