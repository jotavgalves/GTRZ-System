{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": ".types/tools",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "packages/**/*.spec.ts",
    "apps/desktop/src/main/database-runtime.ts",
    "apps/desktop/src/main/backup-service.ts",
    "apps/desktop/src/main/cloud-sync-service.ts",
    "apps/desktop/src/main/operation-reconciliation.ts",
    "apps/desktop/src/main/replica-id-baseline.ts",
    "apps/desktop/src/main/local-mobile-hub.ts",
    "apps/desktop/src/main/local-mobile-server.ts",
    "apps/desktop/src/main/normalize-cloud-receipt.ts",
    "apps/desktop/src/main/escpos-raster.ts",
    "apps/desktop/src/main/force-wipe.ts",
    "apps/desktop/src/main/raw-printer.ts",
    "apps/desktop/src/main/receipt-html.ts",
    "apps/desktop/src/main/thermal-print-service.ts"
  ],
  "references": [
    { "path": "./packages/contracts/tsconfig.json" },
    { "path": "./packages/domain/tsconfig.json" },
    { "path": "./packages/database/tsconfig.json" }
  ]
}
